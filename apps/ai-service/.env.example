PORT=3010
HOST=0.0.0.0

# Vision OCR via OpenAI-compatible API.
# OpenRouter example (works when direct OpenAI is geo-blocked):
#   1) https://openrouter.ai/keys → Create key
#   2) put values below, restart ai-service
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Must support image input (VL). Text-only :free models → 404 "No endpoints found that support image input"
OPENAI_MODEL=nvidia/nemotron-3.5-super-vl:free

# Direct OpenAI (often 403 from BY):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# MinIO (same as applicant-service) — needed to download the uploaded scan.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=abiturent
MINIO_SECRET_KEY=abiturent_secret
MINIO_BUCKET_DOCUMENTS=documents
MINIO_SECURE=false
