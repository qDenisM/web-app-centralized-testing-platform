generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Venue {
  id      String @id @default(uuid()) @db.Uuid
  name    String
  address String
  city    String

  exams Exam[]

  @@map("venues")
}

model Exam {
  id         String   @id @default(uuid()) @db.Uuid
  subjectId  String   @map("subject_id") @db.Uuid
  venueId    String   @map("venue_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz(6)
  duration   Int
  capacity   Int
  seatsTaken Int      @default(0) @map("seats_taken")
  isReserve  Boolean  @default(false) @map("is_reserve")

  venue           Venue            @relation(fields: [venueId], references: [id], onDelete: Restrict)
  applications    Application[]
  waitlistEntries WaitlistEntry[]

  @@index([subjectId])
  @@index([venueId])
  @@index([startsAt])
  @@map("exams")
}

model Application {
  id           String   @id @default(uuid()) @db.Uuid
  examId       String   @map("exam_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  status       String   @default("pending")
  passNumber   String?  @map("pass_number")
  rejectReason String?  @map("reject_reason")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, userId])
  @@index([userId])
  @@index([status])
  @@map("applications")
}

model WaitlistEntry {
  id             String    @id @default(uuid()) @db.Uuid
  examId         String    @map("exam_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  position       Int
  status         String    @default("waiting")
  offerExpiresAt DateTime? @map("offer_expires_at") @db.Timestamptz(6)

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, userId])
  @@unique([examId, position])
  @@index([userId])
  @@index([status])
  @@map("waitlist_entries")
}
