generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Favorite {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  specialtyId String   @map("specialty_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, specialtyId])
  @@index([userId])
  @@map("favorites")
}

model ChanceResult {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  specialtyId   String   @map("specialty_id") @db.Uuid
  status        String
  probability   Int?     @map("probability")
  scoreGap      Int?     @map("score_gap")
  calculatedAt  DateTime @default(now()) @map("calculated_at") @db.Timestamptz(6)

  @@unique([userId, specialtyId])
  @@index([userId])
  @@map("chance_results")
}