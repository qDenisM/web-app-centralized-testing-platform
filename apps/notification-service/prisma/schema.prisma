generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  channel   String   @default("in_app")
  title     String
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

/// Singleton row (id = "default") for system-wide notification toggles.
model NotificationSettings {
  id                     String   @id @default("default")
  allEnabled             Boolean  @default(true) @map("all_enabled")
  verificationEnabled    Boolean  @default(true) @map("verification_enabled")
  applicationEnabled     Boolean  @default(true) @map("application_enabled")
  resultEnabled          Boolean  @default(true) @map("result_enabled")
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("notification_settings")
}

/// Per-user preferences (moderator / examiner cabinets: notification toggles + work defaults).
/// Delivery of role in-app events should call isUserPrefEnabled / isExaminerPrefEnabled before create.
model NotificationPreferences {
  userId             String   @id @map("user_id") @db.Uuid
  allEnabled         Boolean  @default(true) @map("all_enabled")
  verificationQueue  Boolean  @default(true) @map("verification_queue")
  ctApplications     Boolean  @default(true) @map("ct_applications")
  decisions          Boolean  @default(true)
  /// Examiner: confirmations / events around publishing CT results.
  resultsPublish     Boolean  @default(true) @map("results_publish")
  /// Examiner: import job completion / errors.
  resultsImport      Boolean  @default(true) @map("results_import")
  /// Examiner: new approved applicants / exam assignments.
  examAssignments    Boolean  @default(true) @map("exam_assignments")
  /// overview | docs | applications | history
  defaultQueueTab    String   @default("overview") @map("default_queue_tab")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("notification_preferences")
}
